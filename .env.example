# ============ REQUIRED ============
API_ID=                      # my.telegram.org
API_HASH=                    # my.telegram.org
BOT_TOKEN=                   # @BotFather
STORAGE_CHANNEL=-100xxxxxxxxxx
DATABASE_URI=mongodb+srv://user:password@cluster.mongodb.net/
OWNER_ID=                    # your Telegram user ID

# ============ REQUIRED ON KERIT ============
URL=https://your-bot-url.example.com/     # public URL of this bot (must end with /)

# ============ FORCE-SUB (optional) ============
FORCE_SUB_CHANNELS=@ongoingdonghuachat @donghuagalaxy1 @xiao_botz

# ============ OPTIONAL ============
ADMINS=                      # extra admin IDs, space separated
PORT=8080
KEEP_ALIVE=true
RATE_LIMIT_SECONDS=120
REDIRECT_AFTER_SECONDS=0
LINK_EXPIRY_HOURS=2
START_IMAGE=https://imgyx.pages.dev/vfoEY
WEBSITE_URL=https://xiaobhaidonghua.com

# Optional – only if you later move to Render
# RENDER_API_KEY=
# RENDER_SERVICE_ID=
