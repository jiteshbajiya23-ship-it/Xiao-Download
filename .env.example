# ============ REQUIRED ============
API_ID=                      # my.telegram.org -> API development tools
API_HASH=                    # my.telegram.org -> API development tools
BOT_TOKEN=                   # @BotFather
STORAGE_CHANNEL=-100xxxxxxxxxx   # private channel: files are stored here + all logs come here
DATABASE_URI=mongodb+srv://user:password@cluster.mongodb.net/
OWNER_ID=                    # your Telegram user ID (owner commands)
ADMINS=                      # extra admin IDs, space separated (owner is admin automatically)

# ============ FORCE-SUB (optional, can also be managed with /addfsub) ============
FORCE_SUB_CHANNELS=@ongoingdonghuachat @donghuagalaxy1 @xiao_botz

# ============ OPTIONAL ============
# URL=https://your-app.onrender.com/     (Render fills RENDER_EXTERNAL_URL itself)
# RATE_LIMIT_SECONDS=120                 (can be changed live with /setlimit)
# REDIRECT_AFTER_SECONDS=0               (N = send visitor to the website N sec after download starts)
# START_IMAGE=https://imgyx.pages.dev/vfoEY
# WEBSITE_URL=https://xiaobhaidonghua.com
# RENDER_API_KEY=                        (for /restart full redeploy)
# RENDER_SERVICE_ID=
